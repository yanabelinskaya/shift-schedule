DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Production hardening (set in production environment)
# DJANGO_DEBUG=0
# DJANGO_ALLOWED_HOSTS=app.example.com
# DJANGO_CSRF_TRUSTED_ORIGINS=https://app.example.com
# DJANGO_SECURE_SSL_REDIRECT=1
# DJANGO_SESSION_COOKIE_SECURE=1
# DJANGO_CSRF_COOKIE_SECURE=1
# DJANGO_SECURE_HSTS_SECONDS=31536000
# DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=1
# DJANGO_SECURE_HSTS_PRELOAD=1
# DJANGO_SECURE_PROXY_SSL_HEADER=HTTP_X_FORWARDED_PROTO,https

DB_ENGINE=django.db.backends.postgresql
DB_NAME=shift_schedule
DB_USER=postgres
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432
DB_CONN_MAX_AGE=60
DB_CONN_HEALTH_CHECKS=1

# Runtime backup storage (use external volume in production)
# Example: /var/lib/shift-schedule/backups
BACKUP_STORAGE_DIR=./backups
BACKUP_RETENTION_DAYS=30
TASK_SUBMISSION_MAX_FILE_SIZE=10485760
TASK_SUBMISSION_MAX_FILES=5
# TASK_SUBMISSION_ALLOWED_EXTENSIONS=pdf,doc,docx,xls,xlsx,csv,txt,png,jpg,jpeg,webp
# TASK_SUBMISSION_ALLOWED_CONTENT_TYPES=application/pdf,text/plain,image/png,image/jpeg

DRF_THROTTLE_ANON=60/min
DRF_THROTTLE_USER=300/min
API_DEFAULT_PAGE_SIZE=25
API_MAX_PAGE_SIZE=100
API_DEFAULT_LIST_LIMIT=100
API_MAX_LIST_LIMIT=250

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=1
EMAIL_USE_SSL=0
EMAIL_HOST_USER=belikbelka2007@gmail.com
EMAIL_HOST_PASSWORD=app-password
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL=belikbelka2007@gmail.com

# ── Docker compose (только для docker compose) ────────────────────────
# Внешний порт PG, если нужно подключаться с хоста (psql/pgAdmin)
DB_PUBLIC_PORT=5432
# Внешний порт Django runserver
WEB_PORT=8000
# Автосоздание суперпользователя при первом старте контейнера
DJANGO_CREATE_SUPERUSER=1
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=admin
